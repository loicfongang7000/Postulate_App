# France Travail (https://francetravail.io — inscription développeur)
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=
# Optionnel : portée OAuth (défaut ci-dessous)
# FRANCE_TRAVAIL_SCOPE=api_offresdemploiv2 o2dsoffre
# Optionnel : URL token (défaut avec realm partenaire)
# FRANCE_TRAVAIL_TOKEN_URL=https://entreprise.francetravail.fr/connexion/oauth2/access_token?realm=/partenaire
# Optionnel : base API
# FRANCE_TRAVAIL_API_BASE=https://api.francetravail.io

# Adzuna France (https://developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Jooble — agrège Indeed.fr, Monster.fr, Cadremploi… (https://jooble.org/api/about — gratuit 500 req/jour)
JOOBLE_API_KEY=

# Arbeitnow et Remotive : pas de clé nécessaire, actifs automatiquement

# Recherche d'emails recruteurs (https://hunter.io/api-keys) — 25 recherches/mois gratuites
HUNTER_API_KEY=votre_cle_hunter

# Base de contacts complémentaire (https://apollo.io/settings/integrations/api) — 50 crédits/mois gratuits
APOLLO_API_KEY=votre_cle_apollo

# Génération de lettres de motivation (https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# Envoi d'e-mails via Gmail (nécessite un mot de passe d'application Google)
# Activez la double authentification sur votre compte Google, puis créez un
# mot de passe d'application : Compte Google → Sécurité → Mots de passe d'application
GMAIL_USER=votre-adresse@gmail.com
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
